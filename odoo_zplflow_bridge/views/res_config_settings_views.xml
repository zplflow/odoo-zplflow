<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_zplflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.zplflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <app data-string="zplflow" string="zplflow Thermal Printing" name="zplflow">
                    <block title="zplflow Cloud API Configuration">
                        <setting id="zplflow_api_setting" help="Configure your zplflow Cloud API credentials">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="zplflow_api_url" class="col-lg-3 o_light_label"/>
                                    <field name="zplflow_api_url"/>
                                </div>
                                <div class="row mt16">
                                    <label for="zplflow_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="zplflow_api_key" password="True"/>
                                </div>
                                <div class="row mt16">
                                    <label for="zplflow_default_pipeline_id" class="col-lg-3 o_light_label"/>
                                    <field name="zplflow_default_pipeline_id"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
