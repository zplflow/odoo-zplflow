<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_zplflow" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.zplflow</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_zplflow_label"
                        string="Print Thermal Label (zplflow)"
                        type="object"
                        class="btn-secondary"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="zplflow_printer_id"/>
            </xpath>
        </field>
    </record>
</odoo>
